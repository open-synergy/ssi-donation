<odoo>
<record id="donation_type_view_search" model="ir.ui.view">
    <field name="name">donation_type - search</field>
    <field name="model">donation_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="journal_id" />
            </xpath>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_journal_id"
                            string="Journal"
                            context="{'group_by': 'journal_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="donation_type_view_tree" model="ir.ui.view">
    <field name="name">donation_type - tree</field>
    <field name="model">donation_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="journal_id" />
                <field name="income_account_id" optional="hide" />
                <field name="receivable_account_id" optional="hide" />
            </xpath>
        </data>
    </field>
</record>

<record id="donation_type_view_form" model="ir.ui.view">
    <field name="name">donation_type - form</field>
    <field name="model">donation_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="company_id" groups="base.group_multi_company" />
                <field name="company_currency_id" groups="base.group_multi_currency" />
                <field name="journal_id" />
                <field name="income_account_id" />
                <field name="receivable_account_id" />
                <field name="allowed_fund_ids" widget="many2many_tags" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="release" string="Restriction Release">
                    <group name="release_1" colspan="4" col="2">
                        <field name="release_journal_id" />
                        <field name="net_asset_released_account_id" />
                        <field name="net_asset_reclassified_account_id" />
                    </group>
                </page>
                <page name="donor" string="Donor" />
            </xpath>
        </data>
    </field>
</record>

<record id="donation_type_action" model="ir.actions.act_window">
    <field name="name">Donation Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">donation_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="donation_type_menu"
        name="Donation Types"
        parent="menu_donation_configuration"
        action="donation_type_action"
        groups="donation_type_group"
        sequence="20"
    />

</odoo>
