<odoo>
<record id="donation_restriction_release_view_search" model="ir.ui.view">
    <field name="name">donation_restriction_release - search</field>
    <field name="model">donation_restriction_release</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="type_id" />
                <field name="fund_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_fund_id"
                            string="Fund"
                            context="{'group_by': 'fund_id'}"
                        />
                    <filter
                            name="group_by_type_id"
                            string="Type"
                            context="{'group_by': 'type_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="donation_restriction_release_view_tree" model="ir.ui.view">
    <field name="name">donation_restriction_release - tree</field>
    <field name="model">donation_restriction_release</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="type_id" />
                <field name="fund_id" />
                <field name="amount" widget="monetary" />
                <field name="currency_id" invisible="1" />
            </xpath>
        </data>
    </field>
</record>

<record id="donation_restriction_release_view_form" model="ir.ui.view">
    <field name="name">donation_restriction_release - form</field>
    <field name="model">donation_restriction_release</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field name="fund_id" />
                <field name="amount_releasable" readonly="1" />
                <field name="analytic_account_id" readonly="1" />
                <field name="note" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="currency_id" invisible="1" />
                <field name="company_currency_id" invisible="1" />
                <field
                        name="amount"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                <field name="journal_id" />
                <field name="debit_account_id" />
                <field name="credit_account_id" />
                <field name="move_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="donation_restriction_release_action" model="ir.actions.act_window">
    <field name="name">Restriction Releases</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">donation_restriction_release</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="donation_restriction_release_menu"
        name="Restriction Releases"
        parent="menu_donation_root"
        action="donation_restriction_release_action"
        groups="donation_restriction_release_viewer_group"
        sequence="20"
    />
</odoo>
