<odoo>
<record id="policy_template_donation" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_donation" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','donation'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record id="policy_template_donation_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('donation_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Approve -->
<record id="policy_template_donation_approve" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Reject -->
<record id="policy_template_donation_reject" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Restart Approval -->
<record id="policy_template_donation_restart_approval" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('donation_validator_group')])]" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if not document.approval_template_id:
    result = True</field>
</record>

<!-- Cancel -->
<record id="policy_template_donation_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','in',['draft','confirm','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('donation_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Restart -->
<record id="policy_template_donation_restart" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','restart_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','in',['cancel','reject'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('donation_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Manual Number -->
<record id="policy_template_donation_manual_number" model="policy.template_detail">
    <field name="template_id" ref="policy_template_donation" />
    <field
            name="field_id"
            search="[('model_id.model','=','donation'),('name','=','manual_number_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','donation'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('donation_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>
</odoo>
